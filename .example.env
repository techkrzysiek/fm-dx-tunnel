# FM-DX-Tunnel Configuration
# Copy this file to .env and customize values

# Main tunnel domain - subdomains will be created under this domain
# e.g., if TUNNEL_DOMAIN=your-domain.com, users get subdomains like: user1.your-domain.com
TUNNEL_DOMAIN=your-domain.com

# Web panel login (the panel and its API require it)
# If PANEL_PASSWORD is empty, a random password is generated on every start and printed
# in the backend log: docker compose logs fm-dx-tunnel-backend
# Use letters, digits and - _ . here; quote the value if it contains $ or #
PANEL_USER=admin
PANEL_PASSWORD=

# FRP Server configuration (optional, defaults shown)
# FRP_BIND_PORT=7000
# FRP_VHOST_HTTP_PORT=7001
# FRP_KCP_BIND_PORT=7000

# Refuse tunnel clients that do not use TLS (default: true)
# The token is sent in the login message, so only disable this for very old frpc clients
# FRP_TLS_FORCE=true

# Failed tunnel logins: after LOGIN_MAX_FAILURES wrong tokens for one user from one IP,
# further attempts are rejected for LOGIN_FAILURE_WINDOW seconds (0 failures = no limit)
# LOGIN_MAX_FAILURES=10
# LOGIN_FAILURE_WINDOW=600

# Custom 404 page (optional) - shown when tunnel is not connected
# Place your 404.html in config-frps/ directory
FRP_CUSTOM_404_PAGE=/config/404.example.html
